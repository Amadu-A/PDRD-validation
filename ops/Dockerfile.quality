# ops/Dockerfile.quality
# Python 3.12 environment для server-side lint, format и architecture tests.

FROM python:3.12.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /workspace

COPY pyproject.toml /workspace/pyproject.toml
COPY requirements-dev.txt /workspace/requirements-dev.txt

COPY services/api-gateway /workspace/services/api-gateway
COPY services/document-service /workspace/services/document-service
COPY tests /workspace/tests

RUN pip install \
    --no-cache-dir \
    -r /workspace/requirements-dev.txt

CMD ["/bin/sh", "-c", "python -m ruff check . && python -m ruff format --check . && python -m pytest -q"]