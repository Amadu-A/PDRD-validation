# .env.example

COMPOSE_PROJECT_NAME=drawing-validation-ai

# n8n
N8N_VERSION=2.34.5
N8N_PORT=5678
N8N_ENCRYPTION_KEY=bca64dfbd7414bf4251e014fe74a01e8532dbd597ef57264d4629e0701edc989
GENERIC_TIMEZONE=Europe/Moscow

# PostgreSQL
POSTGRES_VERSION=16-alpine
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=postgres

# Qdrant
QDRANT_VERSION=v1.19.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_NORMATIVE_COLLECTION=dva_normative_v2
QDRANT_EXPERIENCE_COLLECTION=dva_experience_v2

# Ollama
OLLAMA_VERSION=0.32.9
OLLAMA_PORT=11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_REQUEST_TIMEOUT=1800
OLLAMA_NUM_CTX=12288
OLLAMA_MAX_ISSUES=6
OLLAMA_MAX_RETRIES=2
OLLAMA_KEEP_ALIVE=15m
OLLAMA_PAGE_FACTS_NUM_PREDICT=1200
OLLAMA_NORM_CHECK_NUM_PREDICT=1800
OLLAMA_FINAL_NUM_PREDICT=1400

# Knowledge Base indexing
KB_CHUNK_SIZE=3500
KB_CHUNK_OVERLAP=500
KB_EMBED_BATCH_SIZE=8

# Runtime RAG
RAG_NORMATIVE_TOP_K=4
RAG_NORMATIVE_MAX_SOURCES=12
RAG_EXPERIENCE_TOP_K=3
RAG_NORMATIVE_TEXT_LIMIT=700
RAG_EXPERIENCE_CONTEXT_LIMIT=600

# PDF service
PDF_SERVICE_PORT=8101
PDF_RENDER_MAX_SIDE=2400
PDF_MAX_ANALYSIS_PAGES=50
PDF_TEXT_LIMIT=12000

# Frontend
FRONTEND_PORT=8080