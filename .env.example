KNOWLEDGE_SERVICE_BROKER__EXCHANGE_NAME=pdrd.knowledge.indexing
KNOWLEDGE_SERVICE_BROKER__ROUTING_KEY=normative.index
KNOWLEDGE_SERVICE_BROKER__MESSAGE_TTL_SECONDS=14400
KNOWLEDGE_SERVICE_BROKER__QUEUE_EXPIRES_SECONDS=604800
KNOWLEDGE_SERVICE_BROKER__TASK_EXPIRES_SECONDS=14400
KNOWLEDGE_SERVICE_BROKER__TASK_SOFT_TIME_LIMIT_SECONDS=14100
KNOWLEDGE_SERVICE_BROKER__TASK_HARD_TIME_LIMIT_SECONDS=14400
