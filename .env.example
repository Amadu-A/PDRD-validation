KNOWLEDGE_SERVICE_DATABASE__USER=pdrd
KNOWLEDGE_SERVICE_DATABASE__PASSWORD=change-me
KNOWLEDGE_SERVICE_DATABASE__POOL_SIZE=5
KNOWLEDGE_SERVICE_DATABASE__MAX_OVERFLOW=10
KNOWLEDGE_SERVICE_DATABASE__POOL_TIMEOUT_SECONDS=10
KNOWLEDGE_SERVICE_DATABASE__CONNECT_TIMEOUT_SECONDS=5
KNOWLEDGE_SERVICE_DATABASE__HEALTH_TIMEOUT_SECONDS=3

KNOWLEDGE_SERVICE_BROKER__HOST=rabbitmq
KNOWLEDGE_SERVICE_BROKER__PORT=5672
KNOWLEDGE_SERVICE_BROKER__USER=pdrd_validation
KNOWLEDGE_SERVICE_BROKER__PASSWORD=change-me
KNOWLEDGE_SERVICE_BROKER__VIRTUAL_HOST=pdrd-validation
