# .env.example

COMPOSE_PROJECT_NAME=pdrd-validation-ai

# API Gateway
API_GATEWAY_BIND_IP=127.0.0.1
API_GATEWAY_HOST_PORT=8200
API_GATEWAY_SERVICE_NAME=PDRD API Gateway
API_GATEWAY_SERVICE_VERSION=0.1.0
API_GATEWAY_ENVIRONMENT=local
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_DOCS_ENABLED=true

# Shared infrastructure
SHARED_DOCKER_NETWORK=ai-shared
N8N_BASE_URL=http://n8n:5678
OLLAMA_BASE_URL=http://ollama:11434
KB_OLLAMA_URL=http://127.0.0.1:11434

# Qdrant
QDRANT_VERSION=v1.19.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_NORMATIVE_COLLECTION=dva_normative_v2
QDRANT_EXPERIENCE_COLLECTION=dva_experience_v2

# Ollama
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_REQUEST_TIMEOUT=1800
OLLAMA_NUM_CTX=16384
OLLAMA_MAX_ISSUES=10
OLLAMA_MAX_RETRIES=2
OLLAMA_KEEP_ALIVE=1m
OLLAMA_PAGE_FACTS_NUM_PREDICT=1600
OLLAMA_NORM_CHECK_NUM_PREDICT=2600
OLLAMA_FINAL_NUM_PREDICT=1800

# Knowledge Base indexing
KB_CHUNK_SIZE=3500
KB_CHUNK_OVERLAP=500
KB_EMBED_BATCH_SIZE=8

# Runtime RAG
RAG_NORMATIVE_TOP_K=4
RAG_NORMATIVE_MAX_SOURCES=12
RAG_EXPERIENCE_TOP_K=3
RAG_NORMATIVE_TEXT_LIMIT=700
RAG_EXPERIENCE_CONTEXT_LIMIT=600

# Temporary Project Context / Explanatory Note RAG
PROJECT_CONTEXT_CHUNK_SIZE=1800
PROJECT_CONTEXT_CHUNK_OVERLAP=250
PROJECT_CONTEXT_TOP_K=5
PROJECT_CONTEXT_TEXT_LIMIT=900
PROJECT_CONTEXT_CLASSIFY_BATCH_SIZE=8
PROJECT_CONTEXT_CLASSIFY_NUM_PREDICT=1200
PROJECT_CONTEXT_EMBED_BATCH_SIZE=12
PROJECT_CONTEXT_COLLECTION_PREFIX=pdrd_project_context

# CAD / DWG / DXF
CAD_MAX_UPLOAD_MB=200
CAD_DWG_CONVERTER_COMMAND=dwg2dxf
CAD_DWG_CONVERTER_TIMEOUT=180
CAD_RENDER_DPI=180
CAD_RENDER_MAX_SIDE=2600
CAD_COMBINED_MAX_SIDE=3200
CAD_MACHINE_TEXT_LIMIT=14000
CAD_TEXT_SAMPLE_LIMIT=160
CAD_BLOCK_SAMPLE_LIMIT=120
CAD_DANGLING_SAMPLE_LIMIT=120
CAD_CONNECTIVITY_TOLERANCE=0.5
CAD_VIRTUAL_INSERT_DEPTH=2

# PDF service
PDF_SERVICE_PORT=8101
PDF_RENDER_MAX_SIDE=2400
PDF_MAX_ANALYSIS_PAGES=50
PDF_TEXT_LIMIT=12000

# Frontend
FRONTEND_PORT=8080