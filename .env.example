# .env.example

COMPOSE_PROJECT_NAME=pdrd-validation-ai

# Project PostgreSQL
PDRD_POSTGRES_VERSION=16-alpine
PDRD_POSTGRES_BIND_IP=0.0.0.0
PDRD_POSTGRES_HOST_PORT=5432
PDRD_POSTGRES_DB=pdrd
PDRD_POSTGRES_USER=pdrd
PDRD_POSTGRES_PASSWORD=change-me

# Shared RabbitMQ / project namespace
PDRD_RABBITMQ_HOST=rabbitmq
PDRD_RABBITMQ_PORT=5672
PDRD_RABBITMQ_VHOST=pdrd-validation
PDRD_RABBITMQ_USER=pdrd_validation
PDRD_RABBITMQ_PASSWORD=change-me

PDRD_CELERY_CONCURRENCY=1

# API Gateway
API_GATEWAY_BIND_IP=127.0.0.1
API_GATEWAY_HOST_PORT=8200
API_GATEWAY_SERVICE_NAME=PDRD API Gateway
API_GATEWAY_SERVICE_VERSION=0.1.0
API_GATEWAY_ENVIRONMENT=local
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_DOCS_ENABLED=true

API_GATEWAY_DATABASE__HOST=postgres
API_GATEWAY_DATABASE__PORT=5432
API_GATEWAY_DATABASE__NAME=pdrd
API_GATEWAY_DATABASE__USER=pdrd
API_GATEWAY_DATABASE__PASSWORD=change-me
API_GATEWAY_DATABASE__POOL_SIZE=5
API_GATEWAY_DATABASE__MAX_OVERFLOW=10
API_GATEWAY_DATABASE__POOL_TIMEOUT_SECONDS=10
API_GATEWAY_DATABASE__CONNECT_TIMEOUT_SECONDS=5
API_GATEWAY_DATABASE__HEALTH_TIMEOUT_SECONDS=3

API_GATEWAY_BROKER__HOST=rabbitmq
API_GATEWAY_BROKER__PORT=5672
API_GATEWAY_BROKER__USER=pdrd_validation
API_GATEWAY_BROKER__PASSWORD=change-me
API_GATEWAY_BROKER__VIRTUAL_HOST=pdrd-validation
API_GATEWAY_BROKER__QUEUE_NAME=pdrd.analysis
API_GATEWAY_BROKER__EXCHANGE_NAME=pdrd.analysis
API_GATEWAY_BROKER__ROUTING_KEY=analysis.execute
API_GATEWAY_BROKER__CONNECT_TIMEOUT_SECONDS=5
API_GATEWAY_BROKER__HEALTH_TIMEOUT_SECONDS=3
API_GATEWAY_BROKER__RESULT_EXPIRES_SECONDS=300

API_GATEWAY_OUTBOX__POLL_INTERVAL_SECONDS=1
API_GATEWAY_OUTBOX__BATCH_SIZE=20

API_GATEWAY_STORAGE__ROOT_PATH=/data/analyses
API_GATEWAY_STORAGE__MAX_UPLOAD_MB=200

API_GATEWAY_ORCHESTRATION__BASE_URL=http://n8n:5678
API_GATEWAY_ORCHESTRATION__PDF_WEBHOOK_PATH=/webhook/analysis/v2/pdf
API_GATEWAY_ORCHESTRATION__CAD_WEBHOOK_PATH=/webhook/analysis/v2/cad
API_GATEWAY_ORCHESTRATION__PDF_CAD_WEBHOOK_PATH=/webhook/analysis/v2/pdf-cad
API_GATEWAY_ORCHESTRATION__REQUEST_TIMEOUT_SECONDS=1800
API_GATEWAY_ORCHESTRATION__CONNECT_TIMEOUT_SECONDS=20

API_GATEWAY_PROJECT_CONTEXT_CLEANUP__BASE_URL=http://knowledge-service:8401
API_GATEWAY_PROJECT_CONTEXT_CLEANUP__REQUEST_TIMEOUT_SECONDS=30
API_GATEWAY_PROJECT_CONTEXT_CLEANUP__CONNECT_TIMEOUT_SECONDS=10

# Document Service
DOCUMENT_SERVICE_BIND_IP=127.0.0.1
DOCUMENT_SERVICE_HOST_PORT=8301
DOCUMENT_SERVICE_SERVICE_NAME=PDRD Document Service
DOCUMENT_SERVICE_SERVICE_VERSION=0.1.0
DOCUMENT_SERVICE_ENVIRONMENT=local
DOCUMENT_SERVICE_HOST=0.0.0.0
DOCUMENT_SERVICE_PORT=8301
DOCUMENT_SERVICE_DOCS_ENABLED=true

DOCUMENT_SERVICE_PDF__MAX_UPLOAD_MB=200
DOCUMENT_SERVICE_PDF__RENDER_MAX_SIDE=2400
DOCUMENT_SERVICE_PDF__MAX_ANALYSIS_PAGES=50
DOCUMENT_SERVICE_PDF__MAX_CONTEXT_PAGES=100
DOCUMENT_SERVICE_PDF__TEXT_LIMIT=12000

DOCUMENT_SERVICE_CAD__MAX_UPLOAD_MB=200
DOCUMENT_SERVICE_CAD__DWG_CONVERTER_COMMAND=dwg2dxf
DOCUMENT_SERVICE_CAD__DWG_CONVERTER_TIMEOUT_SECONDS=180
DOCUMENT_SERVICE_CAD__RENDER_DPI=180
DOCUMENT_SERVICE_CAD__RENDER_MAX_SIDE=2600
DOCUMENT_SERVICE_CAD__MACHINE_TEXT_LIMIT=14000
DOCUMENT_SERVICE_CAD__TEXT_SAMPLE_LIMIT=160
DOCUMENT_SERVICE_CAD__BLOCK_SAMPLE_LIMIT=120
DOCUMENT_SERVICE_CAD__DANGLING_SAMPLE_LIMIT=120
DOCUMENT_SERVICE_CAD__CONNECTIVITY_TOLERANCE=0.5
DOCUMENT_SERVICE_CAD__VIRTUAL_INSERT_DEPTH=2

# Knowledge Service
KNOWLEDGE_SERVICE_BIND_IP=127.0.0.1
KNOWLEDGE_SERVICE_HOST_PORT=8401
KNOWLEDGE_SERVICE_SERVICE_NAME=PDRD Knowledge Service
KNOWLEDGE_SERVICE_SERVICE_VERSION=0.1.0
KNOWLEDGE_SERVICE_ENVIRONMENT=local
KNOWLEDGE_SERVICE_HOST=0.0.0.0
KNOWLEDGE_SERVICE_PORT=8401
KNOWLEDGE_SERVICE_DOCS_ENABLED=true

KNOWLEDGE_SERVICE_EMBEDDING__BASE_URL=http://ollama:11434
KNOWLEDGE_SERVICE_EMBEDDING__MODEL=qwen3-embedding:4b
KNOWLEDGE_SERVICE_EMBEDDING__REQUEST_TIMEOUT_SECONDS=900
KNOWLEDGE_SERVICE_EMBEDDING__CONNECT_TIMEOUT_SECONDS=20
KNOWLEDGE_SERVICE_EMBEDDING__HEALTH_TIMEOUT_SECONDS=5

KNOWLEDGE_SERVICE_QDRANT__BASE_URL=http://qdrant:6333
KNOWLEDGE_SERVICE_QDRANT__NORMATIVE_COLLECTION=dva_normative_v2
KNOWLEDGE_SERVICE_QDRANT__EXPERIENCE_COLLECTION=dva_experience_v2
KNOWLEDGE_SERVICE_QDRANT__REQUEST_TIMEOUT_SECONDS=90
KNOWLEDGE_SERVICE_QDRANT__HEALTH_TIMEOUT_SECONDS=5

KNOWLEDGE_SERVICE_SEARCH__NORMATIVE_TOP_K=4
KNOWLEDGE_SERVICE_SEARCH__NORMATIVE_MAX_SOURCES=12
KNOWLEDGE_SERVICE_SEARCH__EXPERIENCE_TOP_K=3

KNOWLEDGE_SERVICE_PROJECT_CONTEXT__CHUNK_SIZE=1800
KNOWLEDGE_SERVICE_PROJECT_CONTEXT__CHUNK_OVERLAP=250
KNOWLEDGE_SERVICE_PROJECT_CONTEXT__TOP_K=5
KNOWLEDGE_SERVICE_PROJECT_CONTEXT__EMBED_BATCH_SIZE=12
KNOWLEDGE_SERVICE_PROJECT_CONTEXT__UPSERT_BATCH_SIZE=64
KNOWLEDGE_SERVICE_PROJECT_CONTEXT__COLLECTION_PREFIX=pdrd_project_context

# Analysis Service
ANALYSIS_SERVICE_BIND_IP=127.0.0.1
ANALYSIS_SERVICE_HOST_PORT=8501
ANALYSIS_SERVICE_SERVICE_NAME=PDRD Analysis Service
ANALYSIS_SERVICE_SERVICE_VERSION=0.1.0
ANALYSIS_SERVICE_ENVIRONMENT=local
ANALYSIS_SERVICE_HOST=0.0.0.0
ANALYSIS_SERVICE_PORT=8501
ANALYSIS_SERVICE_DOCS_ENABLED=true

ANALYSIS_SERVICE_VISION__BASE_URL=http://ollama:11434
ANALYSIS_SERVICE_VISION__MODEL=qwen3-vl:8b-instruct
ANALYSIS_SERVICE_VISION__REQUEST_TIMEOUT_SECONDS=1800
ANALYSIS_SERVICE_VISION__CONNECT_TIMEOUT_SECONDS=20
ANALYSIS_SERVICE_VISION__HEALTH_TIMEOUT_SECONDS=5
ANALYSIS_SERVICE_VISION__NUM_CTX=16384
ANALYSIS_SERVICE_VISION__MAX_RETRIES=2
ANALYSIS_SERVICE_VISION__KEEP_ALIVE=1m
ANALYSIS_SERVICE_VISION__MAX_RETRY_NUM_PREDICT=6000

ANALYSIS_SERVICE_PIPELINE__PAGE_FACTS_NUM_PREDICT=1600
ANALYSIS_SERVICE_PIPELINE__NORM_CHECK_NUM_PREDICT=2600
ANALYSIS_SERVICE_PIPELINE__FINAL_NUM_PREDICT=1800
ANALYSIS_SERVICE_PIPELINE__MAX_ISSUES=10
ANALYSIS_SERVICE_PIPELINE__FINAL_BATCH_SIZE=2
ANALYSIS_SERVICE_PIPELINE__NORMATIVE_TEXT_LIMIT=700
ANALYSIS_SERVICE_PIPELINE__EXPERIENCE_CONTEXT_LIMIT=600
ANALYSIS_SERVICE_PIPELINE__EXPERIENCE_MIN_SCORE=0.55
ANALYSIS_SERVICE_PIPELINE__MAX_NORMATIVE_QUERIES=7
ANALYSIS_SERVICE_PIPELINE__MAX_IMAGE_BYTES=20971520

ANALYSIS_SERVICE_PROJECT_CONTEXT__CLASSIFY_BATCH_SIZE=8
ANALYSIS_SERVICE_PROJECT_CONTEXT__CLASSIFY_NUM_PREDICT=1200
ANALYSIS_SERVICE_PROJECT_CONTEXT__MIN_TEXT_LENGTH=80
ANALYSIS_SERVICE_PROJECT_CONTEXT__REJECT_CONFIDENCE=0.75
ANALYSIS_SERVICE_PROJECT_CONTEXT__CONTEXT_TEXT_LIMIT=900
ANALYSIS_SERVICE_PROJECT_CONTEXT__QUERY_SOURCE_TEXT_LIMIT=1500

# Shared infrastructure
SHARED_DOCKER_NETWORK=ai-shared
SHARED_N8N_URL=http://127.0.0.1:5678
N8N_BASE_URL=http://n8n:5678

# Qdrant
QDRANT_VERSION=v1.19.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Knowledge Base CLI
KB_OLLAMA_URL=http://127.0.0.1:11434
KB_QDRANT_URL=http://127.0.0.1:6333
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
QDRANT_NORMATIVE_COLLECTION=dva_normative_v2
QDRANT_EXPERIENCE_COLLECTION=dva_experience_v2
KB_CHUNK_SIZE=3500
KB_CHUNK_OVERLAP=500
KB_EMBED_BATCH_SIZE=8

# Frontend
FRONTEND_PORT=8080