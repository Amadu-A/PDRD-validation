KNOWLEDGE_SERVICE_OUTBOX__POLL_INTERVAL_SECONDS=1
KNOWLEDGE_SERVICE_OUTBOX__BATCH_SIZE=20

KNOWLEDGE_SERVICE_STORAGE__ROOT_PATH=/data/normative
KNOWLEDGE_SERVICE_STORAGE__MAX_UPLOAD_MB=200

# Единый embedding provider.
KNOWLEDGE_SERVICE_EMBEDDING__BASE_URL=http://pdrd-multimodal-embedding-service:8601
KNOWLEDGE_SERVICE_EMBEDDING__REQUEST_TIMEOUT_SECONDS=600
KNOWLEDGE_SERVICE_EMBEDDING__CONNECT_TIMEOUT_SECONDS=30
KNOWLEDGE_SERVICE_EMBEDDING__HEALTH_TIMEOUT_SECONDS=10

KNOWLEDGE_SERVICE_INDEXING__CHUNK_SIZE=3500
KNOWLEDGE_SERVICE_INDEXING__CHUNK_OVERLAP=500
KNOWLEDGE_SERVICE_INDEXING__EMBED_BATCH_SIZE=64
KNOWLEDGE_SERVICE_INDEXING__UPSERT_BATCH_SIZE=64

KNOWLEDGE_SERVICE_QDRANT__BASE_URL=http://qdrant:6333

# Stable aliases. Физические коллекции создаёт embedding migrator.
KNOWLEDGE_SERVICE_QDRANT__NORMATIVE_COLLECTION=dva_catalog_active
KNOWLEDGE_SERVICE_QDRANT__EXPERIENCE_COLLECTION=dva_experience_active
KNOWLEDGE_SERVICE_QDRANT__MULTIMODAL_COLLECTION=dva_technical_assignment_active

